# --- GLOBAL OPTIONS ---
# Placement and sizing
layer=overlay
anchor=top-right
width=300
height=100
margin=10,10,10,10
padding=10,10,10,10

# Typography and Visuals
font=CaskaydiaCove Nerd Font Mono 10
background-color={{colors.primary_container.default.hex}}
text-color={{colors.on_primary_container.default.hex}}
border-color={{colors.secondary_container.default.hex}}
border-size=5
border-radius=2
max-icon-size=48
icons=1
icon-location=left

# Behavior
sort=-time
default-timeout=3000
ignore-timeout=1

#clicks
on-button-left=invoke-default-action
on-button-right=dismiss

# --- OVERRIDES ---

# Keep urgent notifications on screen until clicked
[urgency=high]
border-color=#ff5555
default-timeout=0

# Strip styling from low-priority messages
[urgency=low]
border-color=#44475a
